# --- YAML editor ---

msgid "Spaces: %d"
msgstr "空格：%d"

msgid "Read-only"
msgstr "只读"

msgid "No problems"
msgstr "无问题"

msgid "Show or hide the problem list"
msgstr "显示或隐藏问题列表"

msgid "Highlighting disabled for large content"
msgstr "内容过大，已停用语法高亮与检查"

msgid "Ln %d"
msgstr "第 %d 行"

msgid "Ln %d, Col %d"
msgstr "行 %d，列 %d"

msgid "(%d selected)"
msgstr "（已选择 %d 个字符）"

msgid "Tab characters are not allowed in YAML indentation; use spaces."
msgstr "YAML 缩进不允许使用 Tab 字符，请改用空格。"

msgid "Inconsistent indentation: this line does not align with any enclosing level."
msgstr "缩进不一致：此行没有对齐任何上层缩进级别。"

msgid "Unexpected indentation: the entry above already has a value on the same line."
msgstr "意外的缩进：上一条目已在同一行拥有值。"

msgid "A sequence entry (-) is not allowed here; the entry above already has a value."
msgstr "此处不允许出现列表项（-）：上一条目已拥有值。"

msgid "Expected a sequence entry (-) at this indentation."
msgstr "此缩进级别应为列表项（-）。"

msgid "Expected a 'key: value' pair or a sequence entry here."
msgstr "此处应为“键: 值”或列表项（-）。"

msgid "Duplicate key '%s' in the same mapping."
msgstr "同一映射中出现重复的键“%s”。"

msgid "Nested 'key: value' inside a plain value is not allowed; quote the value or move it to its own line."
msgstr "值中不能再包含“键: 值”；请为值加引号，或将其移到单独一行。"

msgid "Unterminated quoted string."
msgstr "引号字符串未闭合。"

msgid "Unclosed flow collection: a [ or { is never closed."
msgstr "流式集合未闭合：存在未关闭的 [ 或 {。"

msgid "Editor shortcuts: "
msgstr "编辑器快捷键："

msgid "indent or outdent"
msgstr "增加或减少缩进"

msgid "keeps and extends indentation"
msgstr "保持并自动扩展缩进"

msgid "toggles comments"
msgstr "切换注释"

msgid "undo"
msgstr "撤销"

msgid "Base Mihomo configuration"
msgstr "Mihomo 源配置"

msgid "Effective Mihomo configuration"
msgstr "Mihomo 正式配置"

msgid "Override YAML"
msgstr "覆写 YAML"

msgid "Validate this source configuration and replace the effective Mihomo configuration?"
msgstr "验证此源配置并替换当前生效的 Mihomo 配置？"

msgid "%d problem"
msgid_plural "%d problems"
msgstr[0] "%d 个问题"

msgid "The editor reports %d YAML problem. Validate this source configuration anyway and replace the effective Mihomo configuration?"
msgid_plural "The editor reports %d YAML problems. Validate this source configuration anyway and replace the effective Mihomo configuration?"
msgstr[0] "编辑器检测到 %d 个 YAML 问题。仍要验证此源配置并替换当前生效的 Mihomo 配置吗？"
