#!/bin/sh /etc/rc.common

# Managed by luci-app-mihomo.
# Runtime logs are consumed through the local controller and are not copied
# into logd's system ring.

START=99
STOP=10
USE_PROCD=1

PROG=/usr/bin/mihomo
CONFIG_DIR=/etc/mihomo
CONFIG_FILE="$CONFIG_DIR/config.yaml"

start_service() {
	[ -x "$PROG" ] || return 1
	[ -f "$CONFIG_FILE" ] || {
		echo "mihomo: missing configuration: $CONFIG_FILE" >&2
		return 1
	}

	mkdir -p /run/mihomo || return 1
	chown root:root /run/mihomo || return 1
	chmod 0700 /run/mihomo || return 1

	procd_open_instance
	procd_set_param command "$PROG" -d "$CONFIG_DIR"
	procd_set_param file "$CONFIG_FILE"
	procd_set_param respawn 3600 10 5
	procd_set_param limits nofile="1048576 1048576"
	procd_set_param term_timeout 10
	procd_set_param stdout 0
	procd_set_param stderr 0
	procd_close_instance
}

reload_service() {
	"$PROG" -t -d "$CONFIG_DIR" || return 1
	procd_send_signal mihomo '*' HUP
}
